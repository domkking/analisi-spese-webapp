{
  "name": "analisi-spese-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Analisi Spese: web app per il controllo del budget per periodo di stipendio (dati solo sul dispositivo).",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^7.0.0"
  }
}
